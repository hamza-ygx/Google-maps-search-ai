# Server-only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
GOOGLE_PLACES_API_KEY=

# Browser-exposed. Restrict by HTTP referrer in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Create a Map ID in Google Cloud Console (Map Management). Falls back to DEMO_MAP_ID.
NEXT_PUBLIC_GOOGLE_MAP_ID=
